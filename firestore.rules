rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Owner-only access to everything under the user's own tree.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Reference runs that judges can read; written only by admins (console/Admin SDK).
    match /publicRuns/{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
